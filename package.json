{

  "name": "eslint-plugin-personnallinter",
  "version": "2.4.2",
  "description": "Personnal lint rules.",

  "type": "commonjs",
  "typings": "./lib/cjs/main.d.cts",
  "main": "./lib/cjs/main.cjs",

  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/main.d.cts",
        "default": "./lib/cjs/main.cjs"
      }
    }
  },

  "scripts": {

    "install-prod": "bun install --production",
    "install-dev": "bun install && bunx husky",

    "lint-back": "bunx eslint --config .eslintrc-back.js --ext .js,.cjs,.mjs \"./lib/cjs/**/*\"",
    "lint-tests": "bunx eslint --config .eslintrc-tests.js --ext .js,.cjs,.mjs \"./test/**/*\"",
    "lint": "bun run lint-back && bun run lint-tests",

    "clean-back": "echo 'clean : not TS module'",
    "clean": "bun run clean-back",

    "build-back": "bun run clean && echo 'build : not TS module'",
    "build": "bun run build-back",

    "check-node-engine": "bunx check-node-engine",
    "check-requires": "bunx used-deps-analyzer ./package.json ./lib/cjs --no-dev --shadows @stylistic/eslint-plugin @typescript-eslint/eslint-plugin @typescript-eslint/parser eslint eslint-plugin-n eslint-plugin-react eslint-plugin-react-hooks",
    "check-updates": "bunx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "bun test --conditions=require --coverage --timeout 10000",
    "unit-tests-local": "bun test --conditions=require --coverage --coverage-reporter=text --timeout 10000",

    "tests": "bun run lint && bun run check-node-engine && bun run check-requires && bun run check-updates && bun run build && bun run unit-tests"

  },
  "files": [
    "/lib/cjs"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.22.3",
    "bun": ">=1.4.5"
  },

  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.4",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "devDependencies": {
    "check-node-engine": "1.2.0",
    "check-version-modules": "2.5.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "typescript": "6.0.3",
    "used-deps-analyzer": "0.4.0"
  },
  "optionalDependencies": {
    "colors": "1.4.0"
  },

  "keywords": [
    "lint",
    "eslint",
    "tslint"
  ],
  "author": "Sébastien VIDAL",
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/eslint-plugin-personnallinter#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/eslint-plugin-personnallinter.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/eslint-plugin-personnallinter/issues"
  }

}
