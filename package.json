{

  "name": "eslint-plugin-personnallinter",
  "version": "2.4.2",
  "description": "Personnal lint rules.",

  "type": "commonjs",
  "typings": "./lib/cjs/main.d.cts",
  "main": "./lib/cjs/main.cjs",

  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/main.d.cts",
        "default": "./lib/cjs/main.cjs"
      }
    }
  },

  "scripts": {

    "lint-back": "npx eslint --config .eslintrc-back.js --ext .js,.cjs,.mjs ./lib/cjs/**/*",
    "lint-tests": "npx eslint --config .eslintrc-tests.js --ext .js,.cjs,.mjs ./test/**/*",
    "lint": "npm run lint-back && npm run lint-tests",

    "clean-back": "echo 'clean : not TS module'",
    "clean": "npm run clean-back",

    "build-back": "npm run clean && echo 'build : not TS module'",
    "build": "npm run build-back",

    "check-node-engine": "npx check-node-engine",
    "check-requires": "npx used-deps-analyzer ./package.json ./lib/cjs --no-dev --shadows @stylistic/eslint-plugin @typescript-eslint/eslint-plugin @typescript-eslint/parser eslint eslint-plugin-n eslint-plugin-react eslint-plugin-react-hooks",
    "check-updates": "npx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "npx c8 --reporter=text-summary --all --include \"lib/cjs/**/*.js\" --include \"lib/cjs/**/*.cjs\" --extension .js --extension .cjs mocha",
    "unit-tests-local": "npx c8 --reporter=html --reporter=text --all --include \"lib/cjs/**/*.js\" --include \"lib/cjs/**/*.cjs\" --extension .js --extension .cjs mocha",

    "tests": "npm run lint && npm run check-node-engine && npm run check-requires && npm run check-updates && npm run build && npm run unit-tests"

  },
  "files": [
    "/lib/cjs"
  ],
  "engines": {
    "node": ">=22.23.4"
  },

  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.4",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "check-node-engine": "1.2.0",
    "check-version-modules": "2.5.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "used-deps-analyzer": "0.4.0"
  },
  "optionalDependencies": {
    "colors": "1.4.0"
  },

  "keywords": [
    "lint",
    "eslint",
    "tslint"
  ],
  "author": "Sébastien VIDAL",
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/eslint-plugin-personnallinter#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/eslint-plugin-personnallinter.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/eslint-plugin-personnallinter/issues"
  }

}
